# SerpAPI Key for live Google Lens reverse search (get free key at https://serpapi.com)
SERPAPI_KEY=your_serpapi_api_key_here

# Ethereum Sepolia RPC URL (get free URL from https://alchemy.com or Infura)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Fresh burner wallet private key with testnet Sepolia ETH (DO NOT use your main wallet)
PRIVATE_KEY=0xyour_private_key_here

# Etherscan API Key for contract verification and transaction lookup
ETHERSCAN_API_KEY=

# (Optional) Contract address if already deployed. Automatically written to out/deployment.json upon 'deploy'
CONTRACT_ADDRESS=
